{
  "name": "mihenk",
  "version": "0.6.0",
  "description": "Kodlama ajanlari icin is defteri: kaydi tutar, kaniti kendisi denetler (MCP sunucusu)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mihenk": "dist/src/cli.js",
    "mihenk-defter": "dist/src/bin.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "duman": "tsc -p . && node dist/test/duman.js",
    "paketle": "tsc -p . && node --disable-warning=ExperimentalWarning dist/src/cli.js paketle",
    "test:engel": "tsc -p . && node dist/test/takim.js engel",
    "test:bilgi": "tsc -p . && node dist/test/takim.js bilgi"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
